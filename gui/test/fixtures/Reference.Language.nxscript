dialect "../../../nxscript/language/Language.nxscript";

Language ReferenceTests {
    UnknownDefinitions: Reject;
    Definitions: [
        Definition Host {
            Root: True;
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Links {
                    Value Value {
                        EffectiveCategories: [Array];
                        Array Array {
                            Names: Optional;
                            EntrySourceForms: [Reference];
                            EntryEffectiveCategories: [Definition];
                            DefinitionKinds: [Record];
                        }
                    }
                },
                Property Items {
                    Value Value {
                        EffectiveCategories: [Array];
                        Array Array {
                            EntrySourceForms: [InlineDefinition];
                            EntryEffectiveCategories: [Definition];
                            DefinitionKinds: [Record];
                        }
                    }
                }
            ];
            Children: [Child Records { Kinds: [Record]; Minimum: 1; Maximum: 2; }];
        },
        Definition Record {
            Root: False;
            Parents: [Host];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Link {
                    Value Value {
                        SourceForms: [Reference];
                        EffectiveCategories: [Definition];
                        Reference Reference { Targets: [Definition]; DefinitionKinds: [Record]; }
                    }
                }
            ];
        }
    ];
}
