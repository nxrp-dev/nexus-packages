dialect "../../../nxscript/language/Language.nxscript";
Language ExternalReferenceEditor {
    UnknownDefinitions: Reject;
    Definitions: [Definition Sample {
        Root: True;
        UnknownProperties: Reject;
        Properties: [Property Value {
            Value Value { SourceForms: [Text, ExternalReference]; Scalar: Text; }
        }];
    }];
}
