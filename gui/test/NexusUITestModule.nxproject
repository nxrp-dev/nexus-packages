dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NexusUITestModule TargetOS[win64] {
    Id: "NXRP.Tests.NexusUITestModule";
    Requires: [@Projects.GUI, @Projects.Core, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.NexusTest, @Projects.NexusScript, @Projects.SQLite, @Projects.Mustache, @Projects.RegExpr];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusUITestModule/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/gui/test/NexusUITestModule.lpr"];
        OutputPath: @NexusUITestModule.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-Sh-"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusUITestModule.OutputRoot];
            UnitPaths: [
                "packages/nexus-packages/gui/test",
                @Tools.Native.RTLPath
            ];
        }
    }
}
