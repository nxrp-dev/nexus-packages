dialect "nxpackage.Language.nxscript";
module NexusPackages "../Packages.RepositoryIndex.nxscript";

// fpGUI and the upstream Virtual TreeView reference are supplied under external/.
// Package-wide License is left unset: these upstream sources retain their own notices.
Package GUI {
    Id: "NXRP.GUI";
    Author: "Kevin Collins";
    Description: "fpGUI controls, skins, rendering and NexusScript editing.";
    Requires: [@NexusPackages.Lua, @NexusPackages.NexusScript, @NexusPackages.RegExpr];
}
