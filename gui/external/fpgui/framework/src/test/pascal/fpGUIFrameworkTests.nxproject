dialect "../../../../../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../../../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project fpGUIFrameworkTests {
    RootDirectory: "../../../../../../../../..";
    OutputRoot: "output/fpgui-tests/" + @Tools.Native.Name + "/framework";
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/gui/external/fpgui/framework/src/test/pascal/fpGUIFrameworkTests.lpr"
        ];
        OutputPath: @fpGUIFrameworkTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                "packages/nexus-packages/gui/external/fpgui/framework/src/test/pascal",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib/render/software",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib/x11",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/gui",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/gui/db",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/reportengine",
                "packages/nexus-packages/fcl-process/src",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                "packages/nexus-packages/serialization/fcl-json/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/users/src",
                @Tools.NexusFPC.SourcePath + "/packages/x11/src",
                "packages/nexus-packages-ext/regexpr/external/tregexpr/src",
                @Tools.NexusFPC.SourcePath + "/packages/pthreads/src",
                "packages/nexus-packages/graphics/fcl-image/src",
                @Tools.NexusFPC.SourcePath + "/packages/paszlib/src",
                "packages/nexus-packages/graphics/pasjpeg/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src",
                "packages/nexus-packages/nxtest/src"
            ];
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/" + @Tools.Native.OS,
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/dummy",
                "packages/nexus-packages/fcl-process/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib/x11",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/resources",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib",
                "packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/gui"
            ];
        }
    }
}
