dialect "../../../../../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project fpGUIFrameworkTests {
    Id: "NXRP.Tests.fpGUIFrameworkTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.RTLExtra, @Projects.GUI, @Projects.FCLProcess, @Projects.FCLBase, @Projects.FCLJSON, @Projects.Users, @Projects.X11, @Projects.RegExpr, @Projects.Pthreads, @Projects.FCLImage, @Projects.PasJPEG, @Projects.NexusTest];
    RootDirectory: "../../../../../../../../..";
    OutputRoot: @Tools.OutputRoot + "/fpGUIFrameworkTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/gui/external/fpgui/framework/src/test/pascal/fpGUIFrameworkTests.lpr"];
        OutputPath: @fpGUIFrameworkTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/gui/external/fpgui/framework/src/test/pascal"
            ];
        }
    }
}
