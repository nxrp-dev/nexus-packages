dialect "../../../../../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../../../../../projects/nxbuild/nxbuild.environment.nxscript";
Project NXLinuxFontLinkTests {
    Id: "NXRP.Tests.NXLinuxFontLinkTests";
    Requires: [@Projects.NexusRTL, @Projects.NexusTest, @Projects.FCLImage, @Projects.GUI];
    RootDirectory: "../../../../../../../../..";
    OutputRoot: @Tools.OutputRoot + "/NXLinuxFontLinkTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/gui/external/fpgui/framework/src/test/pascal/NXLinuxFontLinkTests.lpr"];
        OutputPath: @NXLinuxFontLinkTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
