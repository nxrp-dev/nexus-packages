dialect "../../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project TranslationTools {
    Id: "NXRP.Tests.TranslationTools";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.FCLBase, @Projects.NexusTest, @Projects.FCLProcess];
    RootDirectory: "../../../../../..";
    OutputRoot: @Tools.OutputRoot + "/TranslationTools/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC UpdatePOFiles {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/gui/external/fpgui/tools/updatepofiles.pas"];
        OutputPath: @TranslationTools.OutputRoot + "/updatepofiles";
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
    FPC GenerateIncludeFiles {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/gui/external/fpgui/tools/generateincfiles.pas"];
        OutputPath: @TranslationTools.OutputRoot + "/generateincfiles";
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/gui/external/fpgui/tools/tests/TranslationToolsTests.lpr"];
        OutputPath: @TranslationTools.OutputRoot + "/tests";
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
