dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project NexusTest {
    Id: "NXRP.NexusTest";
    RootDirectory: "../../..";
    Author: "Kevin Collins";
    Description: "Test cases, suites, assertions, results and module contracts.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@Projects.Core, @Projects.JSONRPC, @Projects.JSON, @Projects.FCLJSON];
    Publishes Directories {
        Sources: ["packages/nexus-packages/nxtest/src"];
    }
}
