dialect "nxpackage.Language.nxscript";
module NexusPackages "../Packages.RepositoryIndex.nxscript";

// Command-line and GUI test runners remain separate projects.
Package NexusTest {
    Id: "NXRP.NexusTest";
    Author: "Kevin Collins";
    Description: "Test cases, suites, assertions, results and module contracts.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@NexusPackages.Core, @NexusPackages.JSONRPC, @NexusPackages.JSON];
}
