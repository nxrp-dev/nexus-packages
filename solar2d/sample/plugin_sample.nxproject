dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";

Project plugin_sample {
    BuildTool: FPC;
    ProjectKind: Library;
    BuildFile: "plugin_sample.lpr";
    OutputRoot: "../../../../output/plugin_sample/x86_64-win64";

    TargetPlatform Native { TargetCPU: "x86_64"; TargetOS: "win64"; }
    Toolchain NexusFPC {
        CompilerPath: "../../../../../tools/nexus-fpc/compiler/ppcx64.exe";
    }
    FPCBuildOptions Compiler {
        OutputFile: @plugin_sample.OutputRoot + "/plugin_sample.dll";
        RawOptions: ["-Xe", "-k/defaultlib:CoronaLabs.Corona.Native.lib"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            ExecutableOutputPath: @plugin_sample.OutputRoot;
            UnitOutputPath: "../../../../output/plugin_sample/x86_64-win64/units";
            LibraryPaths: ["../../../../../Nexus2D/platform/windows/Corona.Native.Library.Win32/Release.Simulator/x64/Corona.Native.Library.Win32"];
            UnitPaths: [
                ".",
                "../src",
                "../../lua/src",
                "../../lua/src/bindings",
                "../../../../../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../../../../../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
