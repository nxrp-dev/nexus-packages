dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project Solar2D {
    Id: "NXRP.Solar2D";
    RootDirectory: "../../..";
    Author: "Kevin Collins";
    Description: "Solar2D native plugin API and Pascal event bridge.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@Projects.Lua];
    Publishes Directories {
        Sources: ["packages/nexus-packages/solar2d/src"];
        Headers: ["packages/nexus-packages/solar2d/src"];
    }
}
