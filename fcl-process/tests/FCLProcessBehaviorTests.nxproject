dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLProcessBehaviorTests {
    Id: "NXRP.Tests.FCLProcessBehaviorTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.FCLProcess, @Projects.FCLBase, @Projects.NexusTest];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/FCLProcessBehaviorTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/fcl-process/tests/tdotouch.pas",
            "packages/nexus-packages/fcl-process/tests/tdocat.pas",
            "packages/nexus-packages/fcl-process/tests/tdoexit.pas",
            "packages/nexus-packages/fcl-process/tests/t_genout.pas",
            "packages/nexus-packages/fcl-process/tests/tdols.pas",
            "packages/nexus-packages/fcl-process/tests/FCLProcessBehaviorTests.lpr"
        ];
        OutputPath: @FCLProcessBehaviorTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/fcl-process/tests"
            ];
        }
    }
}
