dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";
Project UsersTests {
    Id: "NXRP.Tests.UsersTests";
    Requires: [@Projects.NexusRTL, @Projects.Users, @Projects.NexusTest];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/UsersTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    LLVM NativeABI {
        CompilerPath: @Tools.Native.LLVMCompiler;
        BuildKind: Object;
        Target: @Tools.Native.Triple;
        SourceFiles: ["packages/nexus-packages/users/tests/users_abi.c"];
        OutputPath: @UsersTests.OutputRoot + "/native";
    }
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages/users/tests/UsersTests.lpr"];
        OutputPath: @UsersTests.OutputRoot;
        RawOptions: ["-Cr", "-Co", "-Ci", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: ["packages/nexus-packages/users/tests"];
            IncludePaths: [];
            ObjectPaths: [@UsersTests.NativeABI.OutputPath];
        }
    }
}
