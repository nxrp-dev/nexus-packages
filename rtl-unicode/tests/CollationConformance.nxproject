dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module "../RTLUnicode.Build.Config.nxscript";
Project CollationConformance {
    RootDirectory: "../../../..";
    SourceRoot: @RTLUnicodeBuild.SourceRoot;
    OutputRoot: @RTLUnicodeBuild.OutputRoot + "/collation";
    FPC Tests {
        CompilerPath: @RTLUnicodeBuild.Compiler;
        SourceFiles: [
            @Tools.NexusFPC.SourcePath + "/tests/test/units/fpwidestring/tuca1.pas",
            @Tools.NexusFPC.SourcePath + "/tests/test/units/fpwidestring/tuca2.pas",
            @Tools.NexusFPC.SourcePath + "/tests/test/units/fpwidestring/tucawsm.pas"
        ];
        OutputPath: @CollationConformance.OutputRoot;
        RawOptions: ["-M" + @RTLUnicodeBuild.TextMode, "-gl"];
        Language Pascal { Mode: ObjFPC; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @RTLUnicodeBuild.RTLPath,
                @CollationConformance.SourceRoot + "/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/paszlib/src",
                @Tools.NexusFPC.SourcePath + "/tests/test/units/fpwidestring"
            ];
            IncludePaths: [@CollationConformance.SourceRoot + "/src/inc"];
        }
    }
}
