dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../RTLUnicode.Build.Config.nxscript";
Project CollationConformance {
    Requires: [@Projects.RTLUnicodeRTL, @Projects.RTLSystem, @Projects.RTLUnicode];
    Id: "NXRP.Tests.CollationConformance";
    RootDirectory: "../../../..";
    SourceRoot: @RTLUnicodeBuild.SourceRoot;
    OutputRoot: @Tools.OutputRoot + "/CollationConformance/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @RTLUnicodeBuild.Compiler;
        SourceFiles: [
            @Tools.NXPC.SourcePath + "/tests/test/units/fpwidestring/tuca1.pas",
            @Tools.NXPC.SourcePath + "/tests/test/units/fpwidestring/tuca2.pas",
            @Tools.NXPC.SourcePath + "/tests/test/units/fpwidestring/tucawsm.pas"
        ];
        OutputPath: @CollationConformance.OutputRoot;
        RawOptions: ["-M" + @RTLUnicodeBuild.TextMode, "-gl"];
        Language Pascal { Mode: ObjFPC; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [@Tools.NXPC.SourcePath + "/tests/test/units/fpwidestring"];
            IncludePaths: [];
        }
    }
}
