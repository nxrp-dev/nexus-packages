dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../RTLUnicode.Build.Config.nxscript";
Project RTLUnicodeTests {
    Id: "NXRP.Tests.RTLUnicodeTests";
    Requires: [@Projects.RTLUnicode, @Projects.NexusTest];
    RootDirectory: "../../../..";
    SourceRoot: @RTLUnicodeBuild.SourceRoot;
    OutputRoot: @Tools.OutputRoot + "/RTLUnicodeTests/" + @Tools.Native.Name;
    FPC Tests {
        CompilerPath: @RTLUnicodeBuild.Compiler;
        SourceFiles: [@RTLUnicodeTests.SourceRoot + "/tests/RTLUnicodeTests.lpr"];
        OutputPath: @RTLUnicodeTests.OutputRoot;
        RawOptions: ["-M" + @RTLUnicodeBuild.TextMode, "-gl", "-Cr", "-Co", "-Ci"];
        Language Pascal { Mode: ObjFPC; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [@RTLUnicodeBuild.RTLPath, @RTLUnicodeTests.SourceRoot + "/tests", @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc", @Tools.NexusFPC.SourcePath + "/rtl/objpas", @Tools.NexusFPC.SourcePath + "/tests/test/units/fpwidestring"];
            IncludePaths: [];
        }
    }
}
