dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";
module "RTLUnicode.Build.Config.nxscript";
Project RTLUnicode {
    Id: "NXRP.RTLUnicode.Units";
    Publishes Directories { Sources: [@RTLUnicode.OutputRoot]; }
    Requires: [@Projects.RTLUnicodeRTL, @Projects.RTLObjPas, @Projects.RTLUnicode];
    RootDirectory: "../../..";
    SourceRoot: @RTLUnicodeBuild.SourceRoot;
    OutputRoot: @Tools.OutputRoot + "/RTLUnicode/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Units {
        CompilerPath: @RTLUnicodeBuild.Compiler;
        BuildKind: Unit;
        SourceFiles: [
            @RTLUnicode.SourceRoot + "/src/inc/unicodeducet.pas",
            @RTLUnicode.SourceRoot + "/src/collations/buildcollations.pas",
            @RTLUnicode.SourceRoot + "/src/inc/cpbuildu.pas",
            @RTLUnicode.SourceRoot + "/src/inc/utf8utils.pas",
            @RTLUnicode.SourceRoot + "/src/inc/graphemebreakproperty.pas",
            @RTLUnicode.SourceRoot + "/src/inc/eastasianwidth.pas"
        ];
        OutputPath: @RTLUnicode.OutputRoot;
        RawOptions: ["-M" + @RTLUnicodeBuild.TextMode];
        Language Pascal { Mode: ObjFPC; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [];
        }
    }
}
