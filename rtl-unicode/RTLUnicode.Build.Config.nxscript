// A Unicode-default build supplies a matching Unicode RTL and selects UNICODESTRINGS.
module "../../../projects/nxbuild/nxbuild.environment.nxscript";
Environment RTLUnicodeBuild {
    Compiler: @Tools.Native.FPCCompiler;
    RTLPath: @Tools.Native.RTLPath;
    TextMode: "ANSISTRINGS";
    SourceRoot: "packages/nexus-packages/rtl-unicode";
    OutputRoot: @Tools.OutputRoot + "/rtl-unicode/ansi";
}
