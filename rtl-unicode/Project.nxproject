dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project RTLUnicode {
    Id: "NXRP.RTLUnicode";
    RootDirectory: "../../..";
    Author: "Inoussa Ouedraogo, Nikolay Nikolov, LazUtils and Free Pascal contributors";
    Description: "Unicode collation, UTF-8 utilities, grapheme clusters, width properties and code-page mappings.";
    Publishes Directories {
        Sources: ["packages/nexus-packages/rtl-unicode/src/inc", "packages/nexus-packages/rtl-unicode/src/collations"];
        Headers: ["packages/nexus-packages/rtl-unicode/src/inc", "packages/nexus-packages/rtl-unicode/src/collations"];
    }
}
