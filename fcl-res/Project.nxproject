dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project FCLRes {
    Id: "NXRP.FCLRes";
    RootDirectory: "../../..";
    Author: "Giulio Bernardi and Free Pascal contributors";
    Description: "Executable resource readers, resource models and file version information.";
    License: "LGPL-2.1-only WITH Independent-modules-exception";
    Publishes Directories {
        Sources: ["packages/nexus-packages/fcl-res/src"];
        Headers: ["packages/nexus-packages/fcl-res/src"];
    }
}
