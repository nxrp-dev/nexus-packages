dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";
module "../../../projects/nxbuild/nxbuild.environment.nxscript";

Project Iconv {
    Id: "NXRP.Unix.Iconv.Units";
    Publishes Directories { Sources: [@Iconv.OutputRoot]; }
    Requires: [@Projects.NexusRTL, @Projects.Iconv];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/Iconv/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Units {
        CompilerPath: @Tools.Native.FPCCompiler;
        BuildKind: Unit;
        SourceFiles: [
            "packages/nexus-packages/iconvenc/src/iconvenc.pas",
            "packages/nexus-packages/iconvenc/src/iconvenc_dyn.pas"
        ];
        OutputPath: @Iconv.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [];
        }
    }
}
