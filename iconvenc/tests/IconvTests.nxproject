dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";
Project IconvTests {
    Id: "NXRP.Tests.IconvTests";
    Requires: [@Projects.NexusRTL, @Projects.Iconv, @Projects.NexusTest];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/IconvTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    LLVM IncompleteLibrary {
        CompilerPath: @Tools.Native.LLVMCompiler;
        BuildKind: SharedLibrary;
        ConfigFiles: ["packages/nexus-packages/iconvenc/tests/incomplete-iconv.cfg"];
        Target: @Tools.Native.Triple;
        PositionIndependentCode: True;
        SourceFiles: ["packages/nexus-packages/iconvenc/tests/incomplete_iconv.c"];
        OutputPath: @IconvTests.OutputRoot + "/native";
    }
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages/iconvenc/tests/IconvTests.lpr"];
        OutputPath: @IconvTests.OutputRoot;
        RawOptions: ["-Cr", "-Co", "-Ci", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: ["packages/nexus-packages/iconvenc/tests"];
            IncludePaths: [];
        }
    }
}
