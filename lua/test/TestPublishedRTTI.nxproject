dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project TestPublishedRTTI {
    Id: "NXRP.Tests.TestPublishedRTTI";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.LibFFI];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/TestPublishedRTTI/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        RawOptions: ["-Cr", "-Co", "-gl"];
        SourceFiles: ["packages/nexus-packages/lua/test/TestPublishedRTTI.pas"];
        OutputPath: @TestPublishedRTTI.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
