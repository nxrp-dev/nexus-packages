dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";

Project TestPublishedRTTI {
    BuildTool: FPC;
    ProjectKind: Program;
    BuildFile: "TestPublishedRTTI.pas";
    OutputRoot: "../../../../output/TestPublishedRTTI/x86_64-win64";

    TargetPlatform Native { TargetCPU: "x86_64"; TargetOS: "win64"; }
    Toolchain NexusFPC {
        CompilerPath: "../../../../../tools/nexus-fpc/compiler/ppcx64.exe";
    }
    FPCBuildOptions Compiler {
        OutputFile: @TestPublishedRTTI.OutputRoot + "/TestPublishedRTTI.exe";
        RawOptions: ["-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            ExecutableOutputPath: @TestPublishedRTTI.OutputRoot;
            UnitOutputPath: "../../../../output/TestPublishedRTTI/x86_64-win64/units";
            UnitPaths: [
                ".",
                "../../../../../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../../../../../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
