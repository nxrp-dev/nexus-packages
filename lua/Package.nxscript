dialect "nxpackage.Language.nxscript";

// No Lua runtime is bundled. Consumers must supply a matching Lua host/library.
// Outside Win64 x86-64, the RTTI bridge also uses NexusFPC ffi.manager and target libffi.
// Package-wide License is left unset: upstream reference headers retain their own notices.
Package Lua {
    Id: "NXRP.Lua";
    Author: "Kevin Collins";
    Description: "Lua API bindings and the generic Pascal RTTI plugin bridge.";
}
