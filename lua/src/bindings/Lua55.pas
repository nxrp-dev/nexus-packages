  lua_WarnFunction = procedure(AUData: Pointer; AMessage: PAnsiChar; AToContinue: cint); cdecl;
  lua_Hook = procedure(L: Plua_State; AAr: Plua_Debug); cdecl;
  lua_Debug = record
    event: cint;
    name, namewhat, what, source: PAnsiChar;
    srclen: SizeUInt;
    currentline, linedefined, lastlinedefined: cint;
    nups, nparams: Byte;
    isvararg: AnsiChar;
    extraargs: Byte;
    istailcall: AnsiChar;
    ftransfer, ntransfer: cint;
    short_src: array[0..LUA_IDSIZE-1] of AnsiChar;
    i_ci: Pointer;
  end;
  luaL_Reg = record
    name: PAnsiChar;
    func: lua_CFunction;
  end;
  TLuaBufferInit = record
    case Integer of
      0: (n: lua_Number);
      1: (u: Double);
      2: (s: Pointer);
      3: (i: lua_Integer);
      4: (l: CLong);
      5: (b: array[0..LUAL_BUFFERSIZE-1] of AnsiChar);
  end;
  luaL_Buffer = record
    b: PAnsiChar;
    size, n: SizeUInt;
    L: Plua_State;
    init: TLuaBufferInit;
  end;
  luaL_Stream = record
    f: PFILE;
    closef: lua_CFunction;
  end;

