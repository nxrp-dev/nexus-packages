function lua_upvalueindex(AIndex: cint): cint; inline; begin Result := LUA_REGISTRYINDEX - AIndex; end;
procedure lua_pop(L: Plua_State; AN: cint); inline; begin lua_settop(L, -AN - 1); end;
procedure lua_newtable(L: Plua_State); inline; begin lua_createtable(L, 0, 0); end;
procedure lua_pushcfunction(L: Plua_State; AFunction: lua_CFunction); inline; begin lua_pushcclosure(L, AFunction, 0); end;
procedure lua_pushglobaltable(L: Plua_State); inline; begin lua_rawgeti(L, LUA_REGISTRYINDEX, LUA_RIDX_GLOBALS); end;
procedure lua_insert(L: Plua_State; AIndex: cint); inline; begin lua_rotate(L, AIndex, 1); end;
procedure lua_remove(L: Plua_State; AIndex: cint); inline; begin lua_rotate(L, AIndex, -1); lua_pop(L, 1); end;
procedure lua_replace(L: Plua_State; AIndex: cint); inline; begin lua_copy(L, -1, AIndex); lua_pop(L, 1); end;
function lua_tointeger(L: Plua_State; AIndex: cint): lua_Integer; inline; begin Result := lua_tointegerx(L, AIndex, nil); end;
function lua_tonumber(L: Plua_State; AIndex: cint): lua_Number; inline; begin Result := lua_tonumberx(L, AIndex, nil); end;
function lua_tostring(L: Plua_State; AIndex: cint): PAnsiChar; inline; begin Result := lua_tolstring(L, AIndex, nil); end;
function lua_newuserdata(L: Plua_State; ASize: SizeUInt): Pointer; inline; begin Result := lua_newuserdatauv(L, ASize, 1); end;
function lua_getuservalue(L: Plua_State; AIndex: cint): cint; inline; begin Result := lua_getiuservalue(L, AIndex, 1); end;
function lua_setuservalue(L: Plua_State; AIndex: cint): cint; inline; begin Result := lua_setiuservalue(L, AIndex, 1); end;
function lua_resetthread(L: Plua_State): cint; inline; begin Result := lua_closethread(L, nil); end;
function lua_getextraspace(L: Plua_State): Pointer; inline; begin Result := Pointer(PtrUInt(L) - LUA_EXTRASPACE); end;
function luaL_getmetatable(L: Plua_State; AName: PAnsiChar): cint; inline; begin Result := lua_getfield(L, LUA_REGISTRYINDEX, AName); end;
function luaL_loadfile(L: Plua_State; AFileName: PAnsiChar): cint; inline; begin Result := luaL_loadfilex(L, AFileName, nil); end;
function luaL_loadbuffer(L: Plua_State; ABuffer: PAnsiChar; ASize: SizeUInt; AName: PAnsiChar): cint; inline; begin Result := luaL_loadbufferx(L, ABuffer, ASize, AName, nil); end;
function luaL_dofile(L: Plua_State; AFileName: PAnsiChar): cint; inline; begin Result := luaL_loadfile(L, AFileName); if Result = LUA_OK then Result := lua_pcallk(L, 0, LUA_MULTRET, 0, 0, nil); end;
function luaL_dostring(L: Plua_State; ASource: PAnsiChar): cint; inline; begin Result := luaL_loadstring(L, ASource); if Result = LUA_OK then Result := lua_pcallk(L, 0, LUA_MULTRET, 0, 0, nil); end;
function luaL_checkstring(L: Plua_State; AArg: cint): PAnsiChar; inline; begin Result := luaL_checklstring(L, AArg, nil); end;
function luaL_optstring(L: Plua_State; AArg: cint; ADefault: PAnsiChar): PAnsiChar; inline; begin Result := luaL_optlstring(L, AArg, ADefault, nil); end;
function luaL_typename(L: Plua_State; AIndex: cint): PAnsiChar; inline; begin Result := lua_typename(L, lua_type(L, AIndex)); end;
procedure luaL_checkversion(L: Plua_State); inline; begin luaL_checkversion_(L, LUA_VERSION_NUM, LUAL_NUMSIZES); end;
procedure luaL_openlibs(L: Plua_State); inline; begin luaL_openselectedlibs(L, -1, 0); end;
procedure luaL_pushfail(L: Plua_State); inline; begin lua_pushnil(L); end;
function luaL_bufflen(ABuffer: PluaL_Buffer): SizeUInt; inline; begin Result := ABuffer^.n; end;
function luaL_buffaddr(ABuffer: PluaL_Buffer): PAnsiChar; inline; begin Result := ABuffer^.b; end;
procedure luaL_addsize(ABuffer: PluaL_Buffer; ASize: SizeUInt); inline; begin Inc(ABuffer^.n, ASize); end;
procedure luaL_buffsub(ABuffer: PluaL_Buffer; ASize: SizeUInt); inline; begin Dec(ABuffer^.n, ASize); end;
function luaL_prepbuffer(ABuffer: PluaL_Buffer): PAnsiChar; inline; begin Result := luaL_prepbuffsize(ABuffer, LUAL_BUFFERSIZE); end;
procedure luaL_addchar(ABuffer: PluaL_Buffer; AChar: AnsiChar); inline; begin if ABuffer^.n >= ABuffer^.size then luaL_prepbuffsize(ABuffer, 1); ABuffer^.b[ABuffer^.n] := AChar; Inc(ABuffer^.n); end;
procedure luaL_newlibtable(L: Plua_State; AFunctions: PluaL_Reg); inline; var lCount: cint; begin lCount := 0; while AFunctions[lCount].name <> nil do Inc(lCount); lua_createtable(L, 0, lCount); end;
procedure luaL_newlib(L: Plua_State; AFunctions: PluaL_Reg); inline; begin luaL_checkversion(L); luaL_newlibtable(L, AFunctions); luaL_setfuncs(L, AFunctions, 0); end;
procedure luaL_argcheck(L: Plua_State; ACondition: Boolean; AArg: cint; AMessage: PAnsiChar); inline; begin if not ACondition then luaL_argerror(L, AArg, AMessage); end;
