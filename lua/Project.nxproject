dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project Lua {
    Id: "NXRP.Lua";
    RootDirectory: "../../..";
    Author: "Kevin Collins";
    Description: "Lua API bindings and the generic Pascal RTTI plugin bridge.";
    Requires: [@Projects.LibFFI];
    Publishes Directories {
        Sources: ["packages/nexus-packages/lua/src", "packages/nexus-packages/lua/src/bindings"];
        Headers: ["packages/nexus-packages/lua/src"];
    }
}
