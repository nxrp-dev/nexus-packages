dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project HashLib4PascalTests {
    Id: "NXRP.Tests.HashLib4PascalTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.NexusTest, @Projects.HashLib4Pascal, @Projects.FCLBase, @Projects.Pthreads];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/HashLib4PascalTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages/hashlib4pascal/tests/HashLib4PascalTests.lpr"];
        OutputPath: @HashLib4PascalTests.OutputRoot;
        RawOptions: ["-O2", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
