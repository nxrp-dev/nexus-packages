dialect "nxpackage.Language.nxscript";
module NexusPackages "../Packages.RepositoryIndex.nxscript";

Package FCLBase {
    Id: "NXRP.FCLBase";
    Author: "Michael Van Canneyt, Sebastian Guenther and Free Pascal contributors";
    Description: "FCL streams, containers, configuration, expressions, codecs, observers and platform utilities.";
    License: "LGPL-2.1-only WITH Independent-modules-exception";
    Requires: [@NexusPackages.Pthreads];
    UnitPaths: ["src"];
}
