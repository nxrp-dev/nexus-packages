dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLBaseReviewTests {
    Id: "NXRP.Tests.FCLBaseReviewTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.NexusTest, @Projects.FCLBase, @Projects.Pthreads];
    RootDirectory: "../../../..";
    SourceRoot: "packages/nexus-packages/fcl-base";
    OutputRoot: @Tools.OutputRoot + "/FCLBaseReviewTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Units {
        CompilerPath: @Tools.Native.FPCCompiler;
        RawOptions: ["-Cr", "-Co", "-Ci", "-Sa", "-gl"];
        SourceFiles: [@FCLBaseReviewTests.SourceRoot + "/tests/FCLBaseReviewTests.lpr"];
        OutputPath: @FCLBaseReviewTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @FCLBaseReviewTests.SourceRoot + "/tests"
            ];
        }
    }
}
