dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";
module "../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLRegistry {
    Id: "NXRP.FCLRegistry.Units";
    Publishes Directories { Sources: [@FCLRegistry.OutputRoot]; }
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.FCLRegistry, @Projects.FCLXML, @Projects.Iconv, @Projects.FCLBase];
    RootDirectory: "../../..";
    SourceRoot: "packages/nexus-packages/fcl-registry";
    OutputRoot: @Tools.OutputRoot + "/FCLRegistry/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Units {
        CompilerPath: @Tools.Native.FPCCompiler;
        BuildKind: Unit;
        SourceFiles: [
            @FCLRegistry.SourceRoot + "/src/xmlreg.pas",
            @FCLRegistry.SourceRoot + "/src/registry.pas"
        ];
        OutputPath: @FCLRegistry.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
