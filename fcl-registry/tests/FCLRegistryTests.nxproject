dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLRegistryTests {
    Id: "NXRP.Tests.FCLRegistryTests";
    Requires: [@Projects.FCLProcess, @Projects.FCLXML, @Projects.Iconv, @Projects.FCLBase, @Projects.FCLRegistry, @Projects.NexusTest];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/FCLRegistryTests/" + @Tools.Native.Name;
    FPC Tests TargetOS[linux] {
        RawOptions: ["-Cr", "-dXMLRegfile_in_CurDir"];
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/fcl-registry/tests/FCLRegistryFixture.lpr",
            "packages/nexus-packages/fcl-registry/tests/FCLRegistryTests.lpr",
            "packages/nexus-packages/fcl-registry/tests/FCLRegistryExampleTests.lpr",
            "packages/nexus-packages/fcl-registry/tests/tregistry2.pas"
        ];
        OutputPath: @FCLRegistryTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                "packages/nexus-packages/fcl-registry/tests",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform
            ];
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64"
            ];
        }
    }
}
