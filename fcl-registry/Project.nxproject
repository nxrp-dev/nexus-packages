dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project FCLRegistry {
    Id: "NXRP.FCLRegistry";
    RootDirectory: "../../..";
    Author: "Michael van Canneyt and Free Pascal contributors";
    Description: "Native Windows registry access with portable XML registry emulation.";
    License: "LGPL-2.1-only WITH Independent-modules-exception";
    Requires: [@Projects.FCLBase, @Projects.FCLXML];
    Publishes Directories { Sources: ["packages/nexus-packages/fcl-registry/src"]; Headers: ["packages/nexus-packages/fcl-registry/src"]; }
}
