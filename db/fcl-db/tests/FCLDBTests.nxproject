dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLDBTests {
    Id: "NXRP.Tests.FCLDBTests";
    Requires: [@Projects.NexusTest, @Projects.FCLProcess, @Projects.FCLDB, @Projects.FCLJSON, @Projects.FCLXML, @Projects.FCLBase, @Projects.Iconv, @Projects.Pthreads];
    RootDirectory: "../../../../..";
    SourceRoot: "packages/nexus-packages/db/fcl-db";
    OutputRoot: @Tools.OutputRoot + "/FCLDBTests/" + @Tools.Native.Name;

    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            @FCLDBTests.SourceRoot + "/tests/FCLDBFixture.lpr",
            @FCLDBTests.SourceRoot + "/tests/FCLDBTests.lpr"
        ];
        OutputPath: @FCLDBTests.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        CodeGeneration RuntimeChecks { RangeChecking: Enabled; }
        Debug Checks { TrashLocalVariables: 1; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                @FCLDBTests.SourceRoot + "/tests",
                @Tools.NexusFPC.SourcePath + "/rtl/inc",
                @FCLDBTests.OutputRoot,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/rtl/objpas",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src"
            ];
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src/inc"
            ];
        }
    }
}
