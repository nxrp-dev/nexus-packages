dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLDBBehaviorTests {
    Id: "NXRP.Tests.FCLDBBehaviorTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.RTLExtra, @Projects.FCLDB, @Projects.FCLJSON, @Projects.FCLBase, @Projects.FCLXML, @Projects.Iconv, @Projects.Pthreads, @Projects.NexusTest];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/FCLDBBehaviorTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages/db/fcl-db/tests/FCLDBBehaviorTests.lpr"];
        OutputPath: @FCLDBBehaviorTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/db/fcl-db/tests"
            ];
        }
    }
}
