dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NXSQLiteTests {
    Id: "NXRP.Tests.NXSQLiteTests";
    Requires: [@Projects.NexusTest];
    RootDirectory: "../../../../..";
    SourceRoot: "packages/nexus-packages/db/sqlite";
    OutputRoot: @Tools.OutputRoot + "/NXSQLiteTests/" + @Tools.Native.Name;

    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [@NXSQLiteTests.SourceRoot + "/test/NXSQLiteTests.lpr"];
        OutputPath: @NXSQLiteTests.OutputRoot;
        PackageSDKIdentity: @Tools.Native.PackageSDKIdentity;
        RequiredPackages: [nxrtl, SQLite];
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        BuildControl Rebuild { BuildAllModules: Enabled; }
        // Keep the SDK shared allocator; executable-local heaptrc replaces it after package initialization.
        Debug Diagnostics { LineInfo: Enabled; }
        CodeGeneration Checks {
            RangeChecking: Enabled;
            OverflowChecking: Enabled;
            IOChecking: Enabled;
        }
        Files Paths {
            UnitPaths: [
                @NXSQLiteTests.SourceRoot + "/test",
                @Tools.Native.PackageSDKPath + "/units",
                @Tools.Native.RTLPath
            ];
            PackagePaths: [@Tools.Native.PackageSDKPath + "/packages", @NXSQLiteTests.OutputRoot];
            LibraryPaths: @Tools.Native.PackageLibraryPaths;
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
        Linking RuntimeLibraries { LinkerOptions: @Tools.Native.LinkerOptions; }
    }
}
