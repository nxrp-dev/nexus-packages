dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project SQLite {
    Id: "NXRP.SQLite.Units";
    Publishes Directories { Sources: [@SQLite.OutputRoot]; }
    Requires: [@Projects.SQLiteNative, @Projects.PackageSDK, @Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.NativeLibraries, @Projects.SQLite, @Projects.FCLBase, @Projects.FCLDB];
    RootDirectory: "../../../..";
    SourceRoot: "packages/nexus-packages/db/sqlite";
    OutputRoot: @Tools.OutputRoot + "/SQLite/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Runtime {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [@SQLite.SourceRoot + "/SQLite.nxpk"];
        OutputPath: @SQLite.OutputRoot;
        PackageSDKIdentity: @Tools.Native.PackageSDKIdentity;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Files Paths {
            PackagePaths: [@Tools.Native.PackageSDKPath + "/packages"];
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
        Linking RuntimeLibraries { LinkerOptions: @Tools.Native.LinkerOptions; }
    }
}
