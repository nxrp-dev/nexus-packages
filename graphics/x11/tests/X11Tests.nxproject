dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";
Project X11Tests {
    Id: "NXRP.Tests.X11Tests";
    Requires: [@Projects.NexusRTL, @Projects.X11, @Projects.NexusTest];
    RootDirectory: "../../../../..";
    SourceRoot: "packages/nexus-packages/graphics/x11";
    OutputRoot: @Tools.OutputRoot + "/X11Tests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            @X11Tests.SourceRoot + "/tests/X11CoreTests.lpr",
            @X11Tests.SourceRoot + "/tests/X11BindingTests.lpr"
        ];
        OutputPath: @X11Tests.OutputRoot;
        RawOptions: ["-Cr", "-Co", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @X11Tests.SourceRoot + "/tests"
            ];
            IncludePaths: [];
        }
    }
}
