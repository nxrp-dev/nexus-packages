dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";
Project PasJPEGTests {
    Id: "NXRP.Tests.PasJPEGTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.PasJPEG, @Projects.NexusTest];
    RootDirectory: "../../../../..";
    SourceRoot: "packages/nexus-packages/graphics/pasjpeg";
    OutputRoot: @Tools.OutputRoot + "/PasJPEGTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
 FPC Tests {
  CompilerPath: @Tools.Native.FPCCompiler;
  SourceFiles: [
      @PasJPEGTests.SourceRoot + "/tests/PasJPEGTests.lpr",
      @PasJPEGTests.SourceRoot + "/tests/PasJPEGFixture.lpr"
  ];
  OutputPath: @PasJPEGTests.OutputRoot;
  Config Options { DisableDefaultConfigFiles: True; }
  Language Pascal { Mode: ObjFPC; }
  Debug Checks { LineInfo: Enabled; }
  Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
  Files Paths {
   CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
   UnitPaths: [
       @PasJPEGTests.SourceRoot + "/tests"
   ];
   IncludePaths: [];
  }
 }
}
