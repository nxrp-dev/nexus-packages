dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";
Project PasJPEG {
    Id: "NXRP.Graphics.PasJPEG.Units";
    Publishes Directories { Sources: [@PasJPEG.OutputRoot]; }
    Requires: [@Projects.NexusRTL, @Projects.PasJPEG];
    RootDirectory: "../../../..";
    SourceRoot: "packages/nexus-packages/graphics/pasjpeg";
    OutputRoot: @Tools.OutputRoot + "/PasJPEG/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Units {
        CompilerPath: @Tools.Native.NXPCCompiler;
        BuildKind: Unit;
        SourceFiles: [
            @PasJPEG.SourceRoot + "/src/buildpasjpeg.pas",
            @PasJPEG.SourceRoot + "/src/jctrans.pas",
            @PasJPEG.SourceRoot + "/src/jdtrans.pas",
            @PasJPEG.SourceRoot + "/src/jconsts.pas",
            @PasJPEG.SourceRoot + "/src/pasjpeg.pas"
        ];
        OutputPath: @PasJPEG.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [];
        }
    }
}
