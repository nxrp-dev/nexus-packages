dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLImageExamples {
    RootDirectory: "../../../..";
    SourceRoot: "packages/nexus-packages/graphics/fcl-image";
    OutputRoot: "output/fcl-image-tests/examples/" + @Tools.Native.Name;

    FPC Examples {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            @FCLImageExamples.SourceRoot + "/examples/createqrcode.pas",
            @FCLImageExamples.SourceRoot + "/examples/demogradient.pas",
            @FCLImageExamples.SourceRoot + "/examples/drawing.pas",
            @FCLImageExamples.SourceRoot + "/examples/fpcanvasalphadraw.pas",
            @FCLImageExamples.SourceRoot + "/examples/imgconv.pas",
            @FCLImageExamples.SourceRoot + "/examples/interpoldemo.pas",
            @FCLImageExamples.SourceRoot + "/examples/qrdemo.pas",
            @FCLImageExamples.SourceRoot + "/examples/textout.pas",
            @FCLImageExamples.SourceRoot + "/examples/transformdemo.pas",
            @FCLImageExamples.SourceRoot + "/examples/wrpngf.pas",
            @FCLImageExamples.SourceRoot + "/examples/wrqoif.pas",
            @FCLImageExamples.SourceRoot + "/examples/xwdtobmp.pas",
            @FCLImageExamples.SourceRoot + "/examples/createbarcode.lpr"
        ];
        OutputPath: @FCLImageExamples.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/packages/pasjpeg/src",
                @Tools.NexusFPC.SourcePath + "/packages/paszlib/src",
                @Tools.NexusFPC.SourcePath + "/packages/hash/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @FCLImageExamples.OutputRoot,
                @FCLImageExamples.SourceRoot + "/src",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src",
                @Tools.NexusFPC.SourcePath + "/packages/iconvenc/src"
            ];
            IncludePaths: [
                @FCLImageExamples.SourceRoot + "/src",
                @Tools.NexusFPC.SourcePath + "/packages/pasjpeg/src",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/dummy",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64"
            ];
        }
    }
}
