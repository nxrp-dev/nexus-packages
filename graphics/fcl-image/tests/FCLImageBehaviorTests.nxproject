dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLImageBehaviorTests {
    Id: "NXRP.Tests.FCLImageBehaviorTests";
    Requires: [@Projects.NexusRTL, @Projects.FCLImage, @Projects.NexusTest];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/FCLImageBehaviorTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/graphics/fcl-image/tests/FCLImageBehaviorTests.lpr"];
        OutputPath: @FCLImageBehaviorTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/graphics/fcl-image/tests"
            ];
        }
    }
}
