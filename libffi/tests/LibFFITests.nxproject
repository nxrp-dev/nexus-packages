dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project LibFFITests {
    Id: "NXRP.Tests.LibFFITests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.LibFFI, @Projects.NexusTest];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/LibFFITests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        RawOptions: ["-Cr", "-Co", "-gl"];
        SourceFiles: ["packages/nexus-packages/libffi/tests/LibFFITests.lpr"];
        OutputPath: @LibFFITests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/libffi/tests"
            ];
        }
    }
}
