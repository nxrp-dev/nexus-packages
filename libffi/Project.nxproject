dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project LibFFI {
    Id: "NXRP.LibFFI";
    RootDirectory: "../../..";
    Author: "Sven Barth and Free Pascal contributors";
    Description: "Native libffi bindings and an optional RTTI invocation/callback manager.";
    License: "LGPL-2.1-only WITH Independent-modules-exception";
    Publishes Directories {
        Sources: ["packages/nexus-packages/libffi/src"];
        Headers: ["packages/nexus-packages/libffi/src"];
    }
}
