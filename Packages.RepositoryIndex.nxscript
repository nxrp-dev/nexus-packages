// Resolve the existing entity dialect through the caller's dialect catalog.
dialect "nxpackage.Language.nxscript";

RepositoryIndex NexusPackages {
    // Sister repository discovery only; no traversal or acquisition is implied.
    TrustedRepository NexusExternal {
        Source: "https://github.com/nxrp-dev/nexus-packages-ext.git";
    }

    ExternalPackage Abbrevia {
        Id: "NXRP.Compression.Abbrevia";
        Repository: @NexusPackages.NexusExternal;
        Description: "Archive and compression runtime units (Abbrevia).";
    }
    ExternalPackage PasZLib {
        Id: "NXRP.Compression.PasZLib";
        Repository: @NexusPackages.NexusExternal;
        Description: "Pascal DEFLATE, zlib, GZIP and ZIP runtime units.";
    }
    ExternalPackage Mustache {
        Id: "NXRP.Mustache";
        Repository: @NexusPackages.NexusExternal;
        Description: "Mustache template parsing and rendering (DMustache).";
    }
    ExternalPackage RegExpr {
        Id: "NXRP.RegExpr";
        Repository: @NexusPackages.NexusExternal;
        Description: "Pure Object Pascal regular expression engine (TRegExpr).";
    }

    // Explicit repository catalog; Descriptor is relative to this index file.
    LocalPackage Core {
        Id: "NXRP.Core";
        Descriptor: "core/Package.nxscript";
        Description: "Shared class registration and command-line parsing.";
    }
    LocalPackage Binding {
        Id: "NXRP.Binding";
        Descriptor: "binding/Package.nxscript";
        Description: "Source-independent value binding, navigation and edit coordination.";
    }
    LocalPackage SQLite {
        Id: "NXRP.SQLite";
        Descriptor: "db/sqlite/Package.nxscript";
        Description: "SQLite bindings, connections and write-through datasets.";
    }
    LocalPackage GUI {
        Id: "NXRP.GUI";
        Descriptor: "gui/Package.nxscript";
        Description: "fpGUI controls, skins, rendering and NexusScript editing.";
    }
    LocalPackage LSP {
        Id: "NXRP.LSP";
        Descriptor: "lsp/Package.nxscript";
        Description: "Reusable Language Server Protocol messages and transports.";
    }
    LocalPackage Lua {
        Id: "NXRP.Lua";
        Descriptor: "lua/Package.nxscript";
        Description: "Lua API bindings and the generic Pascal RTTI plugin bridge.";
    }
    LocalPackage OpenSSL {
        Id: "NXRP.Network.OpenSSL";
        Descriptor: "network/openssl/Package.nxscript";
        Description: "OpenSSL bindings, certificate wrappers and FCL TLS socket adapter.";
    }
    LocalPackage JSONRPC {
        Id: "NXRP.Network.JSONRPC";
        Descriptor: "network/json-rpc/Package.nxscript";
        Description: "Typed JSON-RPC messages, values and command dispatch.";
    }
    LocalPackage Torrent {
        Id: "NXRP.Network.Torrent";
        Descriptor: "network/torrent/Package.nxscript";
        Description: "BitTorrent metadata, peers, trackers and session support.";
    }
    LocalPackage XMPP {
        Id: "NXRP.Network.XMPP";
        Descriptor: "network/xmpp/Package.nxscript";
        Description: "XMPP client protocol, negotiation and messaging modules.";
    }
    LocalPackage NexusScript {
        Id: "NXRP.NexusScript";
        Descriptor: "nxscript/Package.nxscript";
        Description: "NexusScript compilation, validation, editing and emitters.";
    }
    LocalPackage NexusTest {
        Id: "NXRP.NexusTest";
        Descriptor: "nxtest/Package.nxscript";
        Description: "Test cases, suites, assertions, results and module contracts.";
    }
    LocalPackage Serialization {
        Id: "NXRP.Serialization";
        Descriptor: "serialization/Package.nxscript";
        Description: "Object persistence and static string lookup support.";
    }
    LocalPackage JSON {
        Id: "NXRP.Serialization.JSON";
        Descriptor: "serialization/json/Package.nxscript";
        Description: "RTTI-backed typed JSON values and object conversion.";
    }
    LocalPackage DelimitedText {
        Id: "NXRP.Serialization.DelimitedText";
        Descriptor: "serialization/delimited-text/Package.nxscript";
        Description: "Delimited text parsing and conversion to JSON tabular data.";
    }
    LocalPackage Solar2D {
        Id: "NXRP.Solar2D";
        Descriptor: "solar2d/Package.nxscript";
        Description: "Solar2D native plugin API and Pascal event bridge.";
    }
}
