dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../projects/nxbuild/Projects.nxscript";

Project LSP {
    Id: "NXRP.LSP";
    RootDirectory: "../../..";
    Author: "Kevin Collins";
    Description: "Reusable Language Server Protocol messages and transports.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@Projects.FCLBase, @Projects.Core, @Projects.JSONRPC, @Projects.JSON, @Projects.FCLJSON, @Projects.Synapse];
    Publishes Directories {
        Sources: ["packages/nexus-packages/lsp/src", "packages/nexus-packages/lsp/src/protocol"];
        Headers: ["packages/nexus-packages/lsp/src"];
    }
}
