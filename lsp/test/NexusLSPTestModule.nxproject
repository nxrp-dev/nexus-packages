dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";

Project NexusLSPTestModule {
    BuildTool: FPC;
    ProjectKind: Library;
    BuildFile: "NexusLSPTestModule.lpr";
    OutputRoot: "../../../../output/NexusLSP/tests/x86_64-win64";

    TargetPlatform Native { TargetCPU: "x86_64"; TargetOS: "win64"; }
    Toolchain NexusFPC {
        CompilerPath: "$(ProjectRoot)/../../../../../tools/nexus-fpc/compiler/ppcx64.exe";
        LazarusRoot: "C:/lazarus";
    }
    FPCBuildOptions Compiler {
        OutputFile: "$(OutputRoot)/NexusLSPTestModule.dll";
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            ExecutableOutputPath: "$(OutputRoot)";
            UnitOutputPath: "../../../../output/NexusLSP/tests/x86_64-win64/units";
            IncludePaths: ["../../../../output/NexusLSP/tests/x86_64-win64/units"];
            UnitPaths: [
                ".",
                "../src",
                "../src/protocol",
                "../../core/src",
                "../../serialization/json/src",
                "../../network/json-rpc/src",
                "../../nxtest/src",
                "../../network/external/synapse",
                "$(LazarusRoot)/components/lazutils",
                "../../serialization/src",
                "../../../../../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../../../../../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
