dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NexusLSPTestModule TargetOS[win64] {
    Id: "NXRP.Tests.NexusLSPTestModule";
    Requires: [@Projects.NexusRTL, @Projects.LSP, @Projects.Core, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.NexusTest, @Projects.Synapse, @Projects.Serialization];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusLSPTestModule/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/lsp/test/NexusLSPTestModule.lpr"];
        OutputPath: @NexusLSPTestModule.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusLSPTestModule.OutputRoot];
            UnitPaths: [
                "packages/nexus-packages/lsp/test",
                "C:/lazarus" + "/components/lazutils"
            ];
        }
    }
}
