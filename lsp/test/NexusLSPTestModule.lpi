<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <MainUnit Value="0"/>
      <Title Value="NexusLSPTestModule"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="Default" Default="True"/>
    </BuildModes>
    <Units Count="3">
      <Unit0>
        <Filename Value="NexusLSPTestModule.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
      <Unit1>
        <Filename Value="tsNXLSPSharedTests.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit1>
      <Unit2>
        <Filename Value="tsNXLSPProtocolObjectTests.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit2>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="..\..\..\..\output\NexusLSP\tests\$(TargetCPU)-$(TargetOS)\NexusLSPTestModule"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value=".;..\src;..\src\protocol;..\..\..\..\NexusLib\core\src;..\..\serialization\json\src;..\..\network\json-rpc\src;..\..\nxtest\src;..\..\network\external\synapse;$(LazarusDir)\components\lazutils;..\..\serialization\src"/>
      <UnitOutputDirectory Value="..\..\..\..\output\NexusLSP\tests\$(TargetCPU)-$(TargetOS)\units"/>
    </SearchPaths>
    <Linking>
      <Options>
        <ExecutableType Value="Library"/>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
