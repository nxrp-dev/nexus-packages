dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NexusBindingTests TargetOS[win64] {
    Id: "NXRP.Tests.NexusBindingTests";
    Requires: [@Projects.NexusRTL, @Projects.Binding, @Projects.NexusTest];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusBindingTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/binding/tests/NexusBindingTests.lpr"];
        OutputPath: @NexusBindingTests.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-gh", "-gl", "-Cr", "-Co", "-Sa"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/binding/tests"
            ];
        }
    }
}
