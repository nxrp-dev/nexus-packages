dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NexusNetXMPPLiveTest TargetOS[win64] {
    Id: "NXRP.Tests.NexusNetXMPPLiveTest";
    Requires: [@Projects.XMPP, @Projects.Synapse, @Projects.OpenSSL];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusNetXMPPLiveTest/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/network/xmpp/test/NexusNetXMPPLiveTest.lpr"];
        OutputPath: @NexusNetXMPPLiveTest.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-O1", "-gl", "-Cr", "-Co", "-Ci"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/network/xmpp/test",
                @Tools.Native.RTLPath
            ];
        }
    }
}
