dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NexusNetXMPPTests {
    Id: "NXRP.Tests.NexusNetXMPPTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLExtra, @Projects.XMPP, @Projects.FCLXML, @Projects.Iconv, @Projects.OpenSSL, @Projects.Synapse, @Projects.NexusTest, @Projects.FCLBase, @Projects.Pthreads];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusNetXMPPTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/network/openssl/src/fpopenssl.pp",
            "packages/nexus-packages/network/xmpp/test/NexusNetXMPPTests.lpr",
            "packages/nexus-packages/network/xmpp/test/NXXMPPTransportTests.lpr"
        ];
        OutputPath: @NexusNetXMPPTests.OutputRoot;
        RawOptions: ["-Cr", "-Co", "-Ci", "-gl"];
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @NexusNetXMPPTests.OutputRoot,
                "packages/nexus-packages/network/xmpp/test"
            ];
        }
    }
}
