dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";

Project NexusNetXMPPTests {
    BuildTool: FPC;
    ProjectKind: Program;
    BuildFile: "NexusNetXMPPTests.lpr";
    OutputRoot: "../../../../../output/NexusNetXMPPTests/x86_64-win64";

    TargetPlatform Native { TargetCPU: "x86_64"; TargetOS: "win64"; }
    Toolchain NexusFPC {
        CompilerPath: "../../../../../../tools/nexus-fpc/compiler/ppcx64.exe";
    }
    FPCBuildOptions Compiler {
        OutputFile: @NexusNetXMPPTests.OutputRoot + "/NexusNetXMPPTests.exe";
        RawOptions: ["-O1", "-gl", "-Cr", "-Co", "-Ci"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            ExecutableOutputPath: @NexusNetXMPPTests.OutputRoot;
            UnitOutputPath: "../../../../../output/NexusNetXMPPTests/x86_64-win64/units";
            UnitPaths: [
                ".",
                "../src",
                "../../external/synapse",
                "../../openssl/src",
                "../../openssl/synapse",
                "../../../../../../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../../../../../../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
