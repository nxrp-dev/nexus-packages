dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";

Project XMPP {
    Id: "NXRP.Network.XMPP";
    RootDirectory: "../../../..";
    Author: "Kevin Collins";
    Description: "XMPP client protocol, negotiation and messaging modules.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@Projects.FCLXML, @Projects.FCLBase, @Projects.Synapse, @Projects.OpenSSL];
    Publishes Directories {
        Sources: ["packages/nexus-packages/network/xmpp/src"];
        Headers: ["packages/nexus-packages/network/xmpp/src"];
    }
}
