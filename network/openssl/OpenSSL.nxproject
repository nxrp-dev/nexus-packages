dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project OpenSSL {
    Id: "NXRP.Network.OpenSSL.Units";
    Publishes Directories { Sources: [@OpenSSL.OutputRoot]; }
    Requires: [@Projects.OpenSSL, @Projects.Synapse, @Projects.FCLBase, @Projects.Pthreads];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/OpenSSL/" + @Tools.Native.Name;
    FPC Units {
        BuildKind: Unit;
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/network/openssl/src/tpNXOpenSSLTypes.pas",
            "packages/nexus-packages/network/openssl/src/obNXOpenSSLCertificates.pas",
            "packages/nexus-packages/network/openssl/src/openssl.pas",
            "packages/nexus-packages/network/openssl/src/fpopenssl.pp",
            "packages/nexus-packages/network/openssl/src/obNXOpenSSLCrypto.pas",
            "packages/nexus-packages/network/openssl/synapse/obNXSynapseOpenSSL.pas"
        ];
        OutputPath: @OpenSSL.OutputRoot;
        RawOptions: ["-Cr", "-Co", "-Ci", "-gl"];
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @OpenSSL.OutputRoot,
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform
            ];
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.OS,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64"
            ];
        }
    }
}
