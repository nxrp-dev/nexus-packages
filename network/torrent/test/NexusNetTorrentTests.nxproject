dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";
Project NexusNetTorrentTests {
    Id: "NXRP.Tests.NexusNetTorrentTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.RTLExtra, @Projects.Torrent, @Projects.Synapse, @Projects.OpenSSL, @Projects.Core, @Projects.HashLib4Pascal, @Projects.FCLBase, @Projects.Pthreads, @Projects.FCLProcess];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusNetTorrentTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages/network/torrent/test/NexusNetTorrentTests.lpr"];
        OutputPath: @NexusNetTorrentTests.OutputRoot;
        RawOptions: ["-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/network/synapse/src"
            ];
        }
    }
}
