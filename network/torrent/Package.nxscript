dialect "PackageManager.Language.nxscript";

// Additional source prerequisite: network/external/synapse (the preserved upstream submodule).
// Synapse does not yet have an independent descriptor in this catalog.
Package Torrent {
    Id: "NXRP.Network.Torrent";
    Author: "Kevin Collins";
    Description: "BitTorrent metadata, peers, trackers and session support.";
    License: "MPL-2.0-no-copyleft-exception";
}
