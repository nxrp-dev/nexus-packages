dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";

Project Torrent {
    Id: "NXRP.Network.Torrent";
    RootDirectory: "../../../..";
    Author: "Kevin Collins";
    Description: "BitTorrent metadata, peers, trackers and session support.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@Projects.HashLib4Pascal, @Projects.Synapse];
    Publishes Directories {
        Sources: ["packages/nexus-packages/network/torrent/src"];
        Headers: ["packages/nexus-packages/network/torrent/src"];
    }
}
