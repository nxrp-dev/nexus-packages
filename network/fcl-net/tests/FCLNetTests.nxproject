dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLNetTests {
    RootDirectory: "../../../../..";
    OutputRoot: "output/fcl-net-tests/" + @Tools.Native.Name;
    FPC Tests TargetOS[linux] {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/network/fcl-net/tests/FCLNetFixture.lpr",
            "packages/nexus-packages/network/fcl-net/tests/FCLNetTests.lpr"
        ];
        OutputPath: @FCLNetTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                "packages/nexus-packages/network/fcl-net/tests",
                "packages/nexus-packages/fcl-process/src",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/network/fcl-net/src",
                "packages/nexus-packages/nxtest/src"
            ];
            IncludePaths: [
                "packages/nexus-packages/fcl-process/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/network/fcl-net/src/unix",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/" + @Tools.Native.OS,
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src/dummy",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.OS,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc"
            ];
        }
    }
}
