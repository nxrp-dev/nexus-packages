dialect "nxpackage.Language.nxscript";

// Uses NexusFPC rtl-extra, rtl-objpas and fcl-base sources.
Package FCLNet {
    Id: "NXRP.Network.FCLNet";
    Author: "Sebastian Guenther, Michael Van Canneyt and Free Pascal contributors";
    Description: "Resolver and TLS support used by Synapse, plus retained FCL socket APIs.";
    License: "LGPL-2.1-only WITH Independent-modules-exception AND GPL-1.0-or-later AND BSD-4-Clause";
}
