dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";

Project NexusScriptTestModule {
    BuildTool: FPC;
    ProjectKind: Library;
    BuildFile: "NexusScriptTestModule.lpr";
    OutputRoot: "../../../../output/NexusScript/tests/x86_64-win64";

    TargetPlatform Native { TargetCPU: "x86_64"; TargetOS: "win64"; }
    Toolchain NexusFPC {
        CompilerPath: "../../../../../tools/nexus-fpc/compiler/ppcx64.exe";
    }
    FPCBuildOptions Compiler {
        OutputFile: @NexusScriptTestModule.OutputRoot + "/NexusScriptTestModule.dll";
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: Delphi; }
        Files Paths {
            ExecutableOutputPath: @NexusScriptTestModule.OutputRoot;
            UnitOutputPath: "../../../../output/NexusScript/tests/x86_64-win64/units";
            UnitPaths: [
                ".",
                "../src",
                "../../../../projects/nxscript/cli",
                "../../nxtest/src",
                "../../db/sqlite/src/bindings",
                "../../serialization/src",
                "../../serialization/json/src",
                "../../network/json-rpc/src",
                "../../core/src",
                "../../../../packages/nexus-packages-ext/mustache/external/dmustache",
                "../../../../../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../../../../../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
