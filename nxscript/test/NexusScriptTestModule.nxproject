dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NexusScriptTestModule TargetOS[win64] {
    Id: "NXRP.Tests.NexusScriptTestModule";
    Requires: [@Projects.NexusRTL, @Projects.NexusScript, @Projects.NexusTest, @Projects.SQLite, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.Mustache];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusScriptTestModule/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["packages/nexus-packages/nxscript/test/NexusScriptTestModule.lpr"];
        OutputPath: @NexusScriptTestModule.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: Delphi; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/nxscript/test",
                "projects/nxscript/cli"
            ];
        }
    }
}
