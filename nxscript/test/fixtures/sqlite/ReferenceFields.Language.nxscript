dialect "../../../language/Language.nxscript";

Language ReferenceFields {
  UnknownDefinitions: Reject;
  Definitions: [
    Definition Schema {
      Root: True;
      UnknownProperties: Reject;
      Properties: [
        Property Tables {
          Required: True;
          Value Value {
            EffectiveCategories: [Array];
            Array Array {
              Names: Required;
              EntryEffectiveCategories: [Definition];
              DefinitionKinds: [Table];
              Mixed: False;
            }
          }
        }
      ];
    },
    Definition Table {
      Parents: [Schema];
      UnknownProperties: Reject;
      Properties: [
        Property Fields {
          Required: True;
          Value Value {
            EffectiveCategories: [Array];
            Array Array {
              Names: Required;
              EntryEffectiveCategories: [Definition];
              DefinitionKinds: [Field];
              Mixed: False;
            }
          }
        }
      ];
    },
    Definition Field {
      Parents: [Table];
      UnknownProperties: Reject;
      Properties: [
        Property Type {
          Required: True;
          Value Value { Scalar: Text; }
        },
        Property Reference {
          Value Value {
            SourceForms: [Reference];
            EffectiveCategories: [Definition];
            Reference Reference {
              Targets: [Definition];
              DefinitionKinds: [Table];
            }
          }
        },
        Property Alias {
          Value Value {
            SourceForms: [Reference];
            EffectiveCategories: [Definition];
            Reference Reference {
              Targets: [Property, Definition];
              DefinitionKinds: [Table];
            }
          }
        }
      ];
    }
  ];
}
