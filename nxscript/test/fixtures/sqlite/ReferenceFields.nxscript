Schema Example {
  Tables: [
    Table User {
      Fields: [
        Field User_ID { Type: "INTEGER"; },
        Field updated_by { Type: @Example.Tables.User; },
        Field reviewed_by {
          Type: "INTEGER";
          Reference: @Example.Tables.User;
          Alias: @Example.Tables.User.Fields.reviewed_by.Reference;
        },
        Field literal_number { Type: "2"; }
      ];
    }
  ];
}
