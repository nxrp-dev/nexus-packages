dialect "NexusManifest/NexusManifest.Language.nxscript";

NexusManifest ExternalDataSQL {
  Model Domain {
    Source: "../external-data/model.nxscript";
  }

  SourceTemplate CSVData {
    Types: [csv, jcsv];
    Compiler: CommaDelimited;
    Source: "../../../../../../projects/schema/examples/mustache/DatabaseImport.import.mustache";
    OutputExtension: ".sql";
  }

  SourceTemplate TabData {
    Types: [tsv, tab];
    Compiler: TabDelimited;
    Source: "../../../../../../projects/schema/examples/mustache/DatabaseImport.import.mustache";
    OutputExtension: ".sql";
  }
}
