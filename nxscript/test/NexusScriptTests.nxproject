dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project NexusScriptTests {
    Id: "NXRP.Tests.NexusScriptTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.NexusScript, @Projects.NexusTest, @Projects.SQLite, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.Mustache];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusScriptTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages/nxscript/test/NexusScriptTests.lpr"];
        OutputPath: @NexusScriptTests.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        RawOptions: ["-gh", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/nxscript/test",
                "projects/nxscript/cli"
            ];
        }
    }
}
