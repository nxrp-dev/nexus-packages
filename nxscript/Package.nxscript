dialect "PackageManager.Language.nxscript";
module NexusPackages "../Packages.PackageIndex.nxscript";

// Additional source prerequisites: NexusLib/core and lib/dmustache.
// Those components do not yet have independent descriptors in this catalog.
// Compiler and emitter registrations are library code; CLI and language server remain separate projects.
Package NexusScript {
    Id: "NXRP.NexusScript";
    Author: "Kevin Collins";
    Description: "NexusScript compilation, validation, editing and emitters.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@NexusPackages.SQLite, @NexusPackages.DelimitedText, @NexusPackages.JSON];
}
