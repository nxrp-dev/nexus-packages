dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLXMLTests {
    Id: "NXRP.Tests.FCLXMLTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.Iconv, @Projects.FCLXML, @Projects.NexusTest, @Projects.FCLProcess, @Projects.FCLBase];
    RootDirectory: "../../../../..";
    SourceRoot: "packages/nexus-packages/serialization/fcl-xml";
    OutputRoot: @Tools.OutputRoot + "/FCLXMLTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [
            @FCLXMLTests.SourceRoot + "/tests/FCLXMLFixture.lpr",
            @FCLXMLTests.SourceRoot + "/tests/FCLXMLTests.lpr"
        ];
        OutputPath: @FCLXMLTests.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        CodeGeneration RuntimeChecks { RangeChecking: Enabled; }
        // Instrument review probes for range and local-initialization failures.
        Debug Checks { TrashLocalVariables: 1; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @FCLXMLTests.SourceRoot + "/tests"
            ];
        }
    }
}
