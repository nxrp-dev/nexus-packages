dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLXMLBehaviorTests {
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/fcl-xml-tests/" + @Tools.Native.Name + "/behavior";
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/serialization/fcl-xml/tests/FCLXMLBehaviorTests.lpr"
        ];
        OutputPath: @FCLXMLBehaviorTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                "packages/nexus-packages/serialization/fcl-xml/tests",
                "packages/nexus-packages/serialization/fcl-xml/src",
                "packages/nexus-packages/iconvenc/src",
                "packages/nexus-packages/fcl-base/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/nxtest/src"
            ];
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64"
            ];
        }
    }
}
