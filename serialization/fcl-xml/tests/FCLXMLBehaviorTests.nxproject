dialect "../../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../projects/nxbuild/Projects.nxscript";
module "../../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLXMLBehaviorTests {
    Id: "NXRP.Tests.FCLXMLBehaviorTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.FCLXML, @Projects.Iconv, @Projects.FCLBase, @Projects.NexusTest];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/FCLXMLBehaviorTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["packages/nexus-packages/serialization/fcl-xml/tests/FCLXMLBehaviorTests.lpr"];
        OutputPath: @FCLXMLBehaviorTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "packages/nexus-packages/serialization/fcl-xml/tests"
            ];
        }
    }
}
