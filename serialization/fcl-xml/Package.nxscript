dialect "nxpackage.Language.nxscript";
module NexusPackages "../../Packages.RepositoryIndex.nxscript";

// The Unix encoding adapter uses the Iconv package.
Package FCLXML {
    Id: "NXRP.Serialization.FCLXML";
    Requires: [@NexusPackages.FCLBase, @NexusPackages.Iconv];
    Author: "Sebastian Guenther, Sergei Gorelkin and Free Pascal contributors";
    Description: "XML DOM, readers, writers, XPath, configuration, SAX and HTML support.";
    License: "LGPL-2.1-only WITH Independent-modules-exception";
}
