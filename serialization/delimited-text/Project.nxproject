dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";

Project DelimitedText {
    Id: "NXRP.Serialization.DelimitedText";
    RootDirectory: "../../../..";
    Author: "Kevin Collins";
    Description: "Delimited text parsing and conversion to JSON tabular data.";
    License: "MPL-2.0-no-copyleft-exception";
    Requires: [@Projects.FCLJSON];
    Publishes Directories {
        Sources: ["packages/nexus-packages/serialization/delimited-text/src"];
    }
}
