dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";

Project FCLJSON {
    Id: "NXRP.Serialization.FCLJSON";
    RootDirectory: "../../../..";
    Author: "Michael van Canneyt";
    Description: "Free Pascal JSON values, parsing, writing, configuration and RTTI conversion.";
    License: "LGPL-2.1-only WITH Independent-modules-exception";
    Requires: [@Projects.FCLBase];
    Publishes Directories {
        Sources: ["packages/nexus-packages/serialization/fcl-json/src"];
    }
}
