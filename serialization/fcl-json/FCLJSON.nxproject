dialect "../../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../projects/nxbuild/Projects.nxscript";
module "../../../../projects/nxbuild/nxbuild.environment.nxscript";

Project FCLJSON {
    Id: "NXRP.Serialization.FCLJSON.Units";
    Publishes Directories { Sources: [@FCLJSON.OutputRoot]; }
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.FCLJSON, @Projects.FCLBase];
    RootDirectory: "../../../..";
    SourceRoot: "packages/nexus-packages/serialization/fcl-json";
    OutputRoot: @Tools.OutputRoot + "/FCLJSON/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Units {
        CompilerPath: @Tools.Native.FPCCompiler;
        BuildKind: Unit;
        SourceFiles: [
            @FCLJSON.SourceRoot + "/src/fpjson.pas",
            @FCLJSON.SourceRoot + "/src/jsonscanner.pas",
            @FCLJSON.SourceRoot + "/src/jsonreader.pas",
            @FCLJSON.SourceRoot + "/src/jsonparser.pas",
            @FCLJSON.SourceRoot + "/src/jsonwriter.pas",
            @FCLJSON.SourceRoot + "/src/jsonconf.pas",
            @FCLJSON.SourceRoot + "/src/jsoncomparer.pas",
            @FCLJSON.SourceRoot + "/src/fpjsonrtti.pas",
            @FCLJSON.SourceRoot + "/src/fpjsontopas.pas",
            @FCLJSON.SourceRoot + "/src/jsonini.pas",
            @FCLJSON.SourceRoot + "/src/json2yaml.pas",
            @FCLJSON.SourceRoot + "/src/fpjsonapply.pas",
            @FCLJSON.SourceRoot + "/src/fpjsonvalue.pas"
        ];
        OutputPath: @FCLJSON.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
